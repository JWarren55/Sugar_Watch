# Local configuration reference; fill in your own values.
APP_ENV=development
DATABASE_URL=
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally; required when APP_ENV=production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated exact Google emails; required in production.
ALLOWED_EMAILS=

# Optional server-side FoodData Central key; never commit a real key.
USDA_API_KEY=

# Optional public membership signup; Google remains the sign-in provider.
# Enable only after private SMTP setup. TLS is mandatory.
EMAIL_SIGNUP_ENABLED=false
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
