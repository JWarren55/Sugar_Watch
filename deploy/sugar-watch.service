[Unit]
Description=Sugar Watch
After=network.target mysql.service
Wants=mysql.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=sugarwatch
Group=sugarwatch
WorkingDirectory=/opt/sugar-watch/current
EnvironmentFile=/etc/sugar-watch/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sugar-watch/current/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
