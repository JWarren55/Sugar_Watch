# Store completed values only in /etc/sugar-watch/libre-sync.env (root:sugarwatch, 0640).
# Use a dedicated LibreLinkUp follower account with sharing already accepted.
LIBRELINKUP_EMAIL=
LIBRELINKUP_PASSWORD=
LIBRELINKUP_REGION=us
# Confirm compatibility with the current official LibreLinkUp version.
LIBRELINKUP_VERSION=4.16.0
# Explicit identifiers prevent accidentally importing another patient's data.
LIBRELINKUP_PATIENT_ID=
LIBRELINKUP_USER_ID=
